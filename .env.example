# EduLens server configuration - copy to .env and fill in. Never commit .env.

# Required: 32+ random characters, e.g. python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=

# ---- Parent alerts --------------------------------------------------------
# log = record only (demo) | android_gateway = SMS from your own Android phone's SIM
# | fast2sms | msg91 | twilio = SMS gateway accounts
PARENT_SMS_PROVIDER=log
# Alert the student's own phone/e-mail when no parent contact is on file
NOTIFY_STUDENT_IF_NO_PARENT=true
# Link used in e-mails, e.g. http://192.168.1.50:5000/portal
PORTAL_URL=

# SMS from your phone: install "SMS Gateway for Android" (github.com/capcom6/android-sms-gateway),
# start Local Server on the phone, then fill in what it shows (phone and server on the same Wi-Fi)
ANDROID_GATEWAY_URL=http://192.168.1.20:8080
ANDROID_GATEWAY_USER=
ANDROID_GATEWAY_PASSWORD=

COLLEGE_SHORT_NAME=SVIT
ATTENDANCE_MIN_PERCENT=85

FAST2SMS_API_KEY=
FAST2SMS_ROUTE=q
MSG91_AUTH_KEY=
MSG91_FLOW_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# E-mail: alerts, weekly student summaries, login details
# (one college Gmail account with an App Password)
PARENT_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional push notifications
FIREBASE_CREDENTIALS=config/firebase-service-account.json
